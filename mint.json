{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Rentr",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.rentr.live"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#ff6b6b",
    "light": "#ff8585",
