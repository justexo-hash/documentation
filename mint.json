    {
      "name": "Marketplace",
      "icon": "store",
      "url": "https://www.rentr.live/marketplace"
    },
    {
      "name": "GitHub",
      "icon": "github",
      "url": "https://github.com/justexo-hash/rentr"
    },
    {
